TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
SESSION_DRIVER=cookie

# Database Configuration
# Supported engines: postgres, mysql, sqlite
DB_CONNECTION=postgres

# PostgreSQL (default — recommended for production)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=edonis_lms

# MySQL / MariaDB (uncomment and adjust)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=edonis
# DB_PASSWORD=edonis_dev_password
# DB_DATABASE=edonis_lms

# SQLite (uncomment — no server needed, ideal for dev/small deployments)
# DB_CONNECTION=sqlite
# DB_FILENAME=./tmp/db.sqlite3

# Supabase Local Dev (optional — uses PostgreSQL)
# DB_PORT=54322
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=your-local-anon-key
# SUPABASE_SERVICE_KEY=your-local-service-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------
# PII decryption failure mode
# ------------------------------------------------------------------
# true:  an encrypted PII cell (phone, mobile phone, address, ID number)
#        that cannot be decrypted raises a 500 for every request that
#        loads that user.
# false / unset (default): the failure is logged (column, user id and
#        length only) and the field reads as empty. The raw value is
#        never returned in either mode.
#
# Release ordering, per environment:
#   1. Deploy the phone-column widen migration (plan 02-02) and run
#      `node ace pii:scan` in the environment.
#   2. If it reports legacy-plaintext, run `node ace pii:scan --fix` there
#      (audited, non-destructive) BEFORE deploying the decrypt change.
#      With strict mode off, those fields would otherwise read as empty and
#      a user's next profile save would overwrite the original.
#   3. Deploy with PII_DECRYPT_STRICT unset or false. Failures are logged and
#      fields read as empty; nothing raises.
#   4. Set PII_DECRYPT_STRICT=true in that environment only after its
#      `pii:scan` reports 0 undecryptable rows, or after the approved remedy
#      for those rows was applied.
#
# Production (demo.edonis.org) must keep this unset/false until a clean
# production `pii:scan` is recorded AND the production sql_mode and
# phone/mobile_phone length (20-character truncation) checks are done.
PII_DECRYPT_STRICT=false

# ------------------------------------------------------------------
# Test environment (.env.test — committed, no secrets)
# ------------------------------------------------------------------
# `.env.test` is auto-loaded when NODE_ENV=test (set by bin/test.ts) and
# takes precedence over `.env`. It pins the test suites to a throwaway
# SQLite file (DB_CONNECTION=sqlite, DB_FILENAME=./tmp/test.sqlite3) so
# `node ace test` can never reach the development database.
# It must NEVER carry production credentials or real secrets; its APP_KEY
# is a throwaway value. Stop `bun run dev` before running the functional
# suite, otherwise the in-process test server hits EADDRINUSE on PORT.