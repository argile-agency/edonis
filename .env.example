TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
SESSION_DRIVER=cookie

# Database Configuration
# Supported engines: postgres, mysql, sqlite
DB_CONNECTION=postgres

# PostgreSQL (default — recommended for production)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=edonis_lms

# MySQL / MariaDB (uncomment and adjust)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=edonis
# DB_PASSWORD=edonis_dev_password
# DB_DATABASE=edonis_lms

# SQLite (uncomment — no server needed, ideal for dev/small deployments)
# DB_CONNECTION=sqlite
# DB_FILENAME=./tmp/db.sqlite3

# Supabase Local Dev (optional — uses PostgreSQL)
# DB_PORT=54322
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=your-local-anon-key
# SUPABASE_SERVICE_KEY=your-local-service-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=