TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
SESSION_DRIVER=cookie

# Database Configuration
# Supported engines: postgres, mysql, sqlite
DB_CONNECTION=postgres

# PostgreSQL (default — recommended for production)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=edonis_lms

# MySQL / MariaDB (uncomment and adjust)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=edonis
# DB_PASSWORD=edonis_dev_password
# DB_DATABASE=edonis_lms

# SQLite (uncomment — no server needed, ideal for dev/small deployments)
# DB_CONNECTION=sqlite
# DB_FILENAME=./tmp/db.sqlite3

# Supabase Local Dev (optional — uses PostgreSQL)
# DB_PORT=54322
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=your-local-anon-key
# SUPABASE_SERVICE_KEY=your-local-service-key

# Course content file storage (optional)
# Absolute path, or relative to the project root. Defaults to
# <project>/storage/content_files (also when running from build/, which is
# wiped by every `bun run build`). In production, point it at a persistent
# directory or volume outside the build output, e.g. /var/lib/edonis/content_files
# CONTENT_STORAGE_PATH=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------
# Test environment (.env.test — committed, no secrets)
# ------------------------------------------------------------------
# `.env.test` is auto-loaded when NODE_ENV=test (set by bin/test.ts) and
# takes precedence over `.env`. It pins the test suites to a throwaway
# SQLite file (DB_CONNECTION=sqlite, DB_FILENAME=./tmp/test.sqlite3) so
# `node ace test` can never reach the development database.
# It must NEVER carry production credentials or real secrets; its APP_KEY
# is a throwaway value. Stop `bun run dev` before running the functional
# suite, otherwise the in-process test server hits EADDRINUSE on PORT.